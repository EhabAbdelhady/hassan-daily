# ==============================================================================
# HASSAN DAILY INFOGRAPHIC AUTOMATION CONFIGURATION
# ==============================================================================

# Operational Mode
# DRY_RUN=true: everything runs (including the token check) but nothing is uploaded or posted
DRY_RUN=true
# REQUIRE_APPROVAL=true: the run stops after the preview email; posting happens only when approved
REQUIRE_APPROVAL=true
# Approval later than this many hours after the preview is ignored (nothing is posted)
CUTOFF_HOURS=2.0
POST_TO_FACEBOOK=true
POST_TO_INSTAGRAM=false

# AI Configuration (Supported: anthropic, openai, gemini)
AI_PROVIDER=anthropic
# Optional: override the provider's default model (anthropic: claude-opus-5-5, openai: gpt-4o, gemini: gemini-3.8-flash)
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Market Data (optional: CoinGecko free "demo" key raises rate limits)
COINGECKO_API_KEY=

# Email Preview Configuration (Gmail SMTP or Resend)
EMAIL_SERVICE=gmail
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ALERT_RECIPIENT_EMAIL=your_email@gmail.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloud Hosting for Instagram Image Containers (Cloudinary or AWS S3)
IMAGE_HOSTING=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta Graph API (Facebook Page & Instagram Business)
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
